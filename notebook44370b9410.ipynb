    "#-----------------------------------------------------------\n",
    "# Block 3: Data Visualization and Analysis\n",
    "#-----------------------------------------------------------\n",
    "def display_sample_images_with_boxes(dataset: List[dict], num_images: int = 4):\n",
    "    \"\"\"Displays a few sample images with their bounding boxes.\"\"\"\n",
    "    for data in random.sample(dataset, num_images):\n",
    "        image = Image.open(data['image_path'])\n",
    "        fig, ax = plt.subplots(1, figsize=(8, 8))\n",
    "        ax.imshow(image)\n",
    "        \n",
    "        img_width, img_height = image.size\n",
    "        \n",
    "        for label in data['labels']:\n",
    "            parts = list(map(float, label.strip().split()))\n",
    "            class_id, x_c, y_c, w, h = int(parts[0]), parts[1], parts[2], parts[3], parts[4]\n",
    "            \n",
    "            x_min = (x_c - w / 2) * img_width\n",
    "            y_min = (y_c - h / 2) * img_height\n",
    "            box_width = w * img_width\n",
    "            box_height = h * img_height\n",
    "            \n",
    "            bbox = patches.Rectangle((x_min, y_min), box_width, box_height, linewidth=2, edgecolor='lime', facecolor='none')\n",
    "            ax.add_patch(bbox)\n",
    "            ax.text(x_min, y_min - 10, CLASS_NAMES[class_id], color='black', fontsize=12, bbox=dict(facecolor='lime', alpha=0.7))\n",
    "            \n",
    "        plt.title(f\"Image: {os.path.basename(data['image_path'])}\")\n",
    "        plt.axis('off')\n",
    "        plt.show()\n",
    "\n",
    "def plot_class_distribution(dataset: List[dict]):\n",
    "    \"\"\"Analyzes and plots the distribution of classes.\"\"\"\n",
    "    class_ids = [int(label.split()[0]) for data in dataset for label in data['labels']]\n",
    "    class_counts = pd.Series(class_ids).value_counts().sort_index()\n",
    "    \n",
    "    plt.figure(figsize=(14, 8))\n",
    "    sns.barplot(x=class_counts.index, y=class_counts.values, palette='viridis')\n",
    "    plt.title('Class Distribution in Training Dataset', fontsize=16)\n",
    "    plt.xlabel('Class Name', fontsize=12)\n",
    "    plt.ylabel('Count', fontsize=12)\n",
    "    plt.xticks(ticks=range(NUM_CLASSES), labels=CLASS_NAMES, rotation=45, ha=\"right\")\n",
    "    plt.show()\n",
    "\n",
    "# Visualize the data\n",
    "print(\"\\n--- Displaying Sample Training Images ---\")\n",
    "display_sample_images_with_boxes(train_dataset)\n",
    "\n",
    "print(\"\\n--- Plotting Class Distribution ---\")\n",
    "plot_class_distribution(train_dataset)"
   ]
