    "#-----------------------------------------------------------\n",
    "# Block 4: Model Architecture\n",
    "#-----------------------------------------------------------\n",
from tensorflow.keras.applications import EfficientNetB0
from tensorflow.keras.applications import EfficientNetB0
from tensorflow.keras.models import Model

def backbone_net(input_tensor: tf.Tensor):

    base_model = EfficientNetB0(
        weights='imagenet',
        include_top=False,
        input_tensor=input_tensor
    )

    # Freeze pretrained layers
    base_model.trainable = False

    # Extract multi-scale features for FPN
    c3 = base_model.get_layer("block4a_expand_activation").output
    c4 = base_model.get_layer("block6a_expand_activation").output
    c5 = base_model.get_layer("top_activation").output

    return c3, c4, c5
    "\n",
    "def fpn(backbone_output: Tuple[tf.Tensor, tf.Tensor, tf.Tensor]) -> tf.Tensor:\n",
    "    \"\"\"Feature Pyramid Network to combine features at different scales.\"\"\"\n",
    "    c3, c4, c5 = backbone_output\n",
    "    P5 = Conv2D(256, (1, 1), activation='relu', padding='same')(c5)\n",
    "    P5_upsampled = UpSampling2D(size=(2, 2))(P5)\n",
    "    \n",
    "    P4 = Concatenate()([c4, P5_upsampled])\n",
    "    P4 = Conv2D(256, (3, 3), activation='relu', padding='same')(P4)\n",
    "    P4_upsampled = UpSampling2D(size=(2, 2))(P4)\n",
    "\n",
    "    P3 = Concatenate()([c3, P4_upsampled])\n",
    "    P3 = Conv2D(256, (3, 3), activation='relu', padding='same')(P3)\n",
    "    return P3\n",
    "\n",
    "def detection_head(input_tensor: tf.Tensor, num_classes: int, num_anchors: int) -> Tuple[tf.Tensor, tf.Tensor, tf.Tensor]:\n",
    "    \"\"\"The final layers for classification and bounding box regression.\"\"\"\n",
    "    x = GlobalAveragePooling2D()(input_tensor)\n",
    "    x = Dense(512, activation='relu')(x)\n",
    "    x = Dropout(0.5)(x)\n",
    "    x = Dense(512, activation='relu')(x)\n",
    "\n",
    "    class_output = Dense(num_classes, activation='softmax', name='class_output')(x)\n",
    "    bbox_output = Dense(num_classes * 4, activation='sigmoid', name='bbox_output')(x)\n",
    "    bbox_output = Reshape((num_classes, 4), name='reshape_bboxes')(bbox_output)\n",
    "    objectness_output = Dense(num_anchors, activation='sigmoid', name='objectness_output')(x)\n",
    "    return class_output, bbox_output, objectness_output\n",
    "\n",
    "def build_model(image_size: Tuple[int, int], num_classes: int, num_anchors: int) -> Model:\n",
    "    \"\"\"Builds and compiles the complete model.\"\"\"\n",
    "    inputs = Input(shape=(*image_size, 3))\n",
    "    backbone_features = backbone_net(inputs)\n",
    "    fpn_features = fpn(backbone_features)\n",
    "    class_out, bbox_out, obj_out = detection_head(fpn_features, num_classes, num_anchors)\n",
    "    \n",
    "    model = Model(inputs=inputs, outputs=[class_out, bbox_out, obj_out])\n",
    "    return model"
   ]
